/* =========================================================================
 * Gemio Textual TUI Stylesheet (256色互換・最小 80x24 レスポンシブ設計)
 * ========================================================================= */

Screen {
    layout: vertical;
    background: $surface;
    color: $text;
}

/* 1. StatusHeader (上部固定バー) */
StatusHeader {
    dock: top;
    width: 100%;
    height: auto;
    max-height: 2;
    background: $panel;
    color: $text;
    border-bottom: solid $primary-darken-2;
    padding: 0 1;
}

StatusHeader Horizontal {
    width: 100%;
    height: auto;
}

.header-brand {
    width: auto;
    max-width: 22;
    text-style: bold;
    color: $accent;
    padding-right: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.header-sep {
    width: auto;
    color: $text-muted;
    margin: 0;
}

.header-badge {
    width: auto;
    padding: 0 1;
    text-style: bold;
    text-wrap: nowrap;
}

.header-badge:hover {
    text-style: bold reverse;
}

.badge-mode-std {
    color: $success;
}

.badge-mode-dev {
    color: #d75fd7;
}

.badge-approval-normal {
    color: $success;
}

.badge-approval-edit {
    color: $warning;
}

.badge-approval-trust {
    color: $error;
}

.badge-model {
    color: $accent;
}

.badge-ctx-normal {
    color: $success;
}

.badge-ctx-warning {
    color: $warning;
}

.badge-ctx-danger {
    color: $error;
}

/* 2. ChatTimeline (中央独立スクロール領域) */
ChatTimeline {
    width: 100%;
    height: 1fr;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

/* WelcomeBanner */
WelcomeBanner {
    width: 100%;
    height: auto;
    border: round $accent;
    background: $panel;
    padding: 0 1;
    margin: 1 0;
}

/* TurnWidget (1回の対話ターン) */
TurnWidget {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

/* UserMessageCard (ユーザー入力: プレーンテキストそのまま表示) */
UserMessageCard {
    width: 100%;
    height: auto;
    border-left: thick $success;
    background: $panel;
    padding: 0 1;
    margin-top: 1;
}

.card-header-row {
    width: 100%;
    height: 1;
    align: left middle;
}

.card-role-user {
    text-style: bold;
    color: $success;
    width: 1fr;
}

.card-role-assistant {
    text-style: bold;
    color: $accent;
    width: 1fr;
}

.card-role-aborted {
    text-style: bold;
    color: $error;
    width: 1fr;
}

.card-timestamp {
    width: auto;
    color: $text-muted;
    margin-right: 1;
}

.copy-btn {
    width: auto;
    min-width: 6;
    height: 1;
    border: none;
    padding: 0 1;
    background: $surface-lighten-1;
    color: $text;
}

.copy-btn:hover, .copy-btn:focus {
    background: $accent;
    color: $surface;
    text-style: bold;
}

.user-prompt-body {
    width: 100%;
    height: auto;
    padding-top: 0;
    color: $text;
}

/* ActivityGroup (ツール呼び出し・思考ログ折りたたみ) */
ActivityGroup {
    width: 100%;
    height: auto;
    margin: 0 0 0 1;
}

ActivityGroup Collapsible {
    width: 100%;
    height: auto;
    border: none;
    background: $surface;
    padding: 0;
}

ActivityGroup Collapsible > Contents {
    width: 100%;
    height: auto;
    padding: 0 0 0 2;
}

.activity-items {
    width: 100%;
    height: auto;
}

.activity-log-item {
    width: 100%;
    height: auto;
    padding-left: 0;
}

/* AssistantMessageCard (AI回答: Markdownレンダリング表示) */
AssistantMessageCard {
    width: 100%;
    height: auto;
    border-left: thick $accent;
    background: $surface-darken-1;
    padding: 0 1;
    margin-top: 0;
}

AssistantMessageCard.aborted {
    border-left: thick $error;
}

AssistantMessageCard Markdown {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
}

/* MaterialsModal 専用レイアウト (80x24 対応) */
MaterialsModal {
    align: center middle;
    background: $background 60%;
}

.materials-dialog {
    height: 92%;
    max-height: 36;
    padding: 0 2;
}

.materials-diag-row {
    width: 100%;
    height: auto;
    align: left middle;
}

.materials-diagnosis {
    width: 1fr;
    height: auto;
}

.materials-aux-btn {
    width: auto;
    min-width: 8;
    height: 1;
    border: none;
    padding: 0 1;
    margin-left: 1;
}

#materials-tabs {
    width: 100%;
    height: 1fr;
}

#materials-tabs > ContentSwitcher {
    width: 100%;
    height: 1fr;
}

#materials-tabs TabPane {
    width: 100%;
    height: 1fr;
    padding: 0;
}

.materials-table {
    width: 100%;
    height: auto;
    max-height: 8;
}

.materials-preview-scroll {
    width: 100%;
    height: 1fr;
    background: $surface;
    border: solid $primary-darken-2;
    padding: 0 1;
}

.materials-list-actions {
    width: 100%;
    height: auto;
    align: left middle;
}

.materials-list-actions Button {
    margin-right: 1;
}

.materials-add-textarea {
    width: 100%;
    height: 1fr;
    min-height: 4;
    border: tall $primary-darken-1;
    background: $surface;
}

/* 3. ActivityBar & PromptComposer (下部固定入力エリア) */
ActivityBar {
    width: 100%;
    height: 1;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}

ActivityBar.busy {
    background: $primary-darken-3;
    color: $warning;
    text-style: bold;
}

.activity-status-text {
    width: 1fr;
    height: 1;
}

.cancel-turn-btn {
    min-width: 14;
    height: 1;
    border: none;
    padding: 0 1;
    background: $error;
    color: $text;
    text-style: bold;
}

PromptComposer {
    width: 100%;
    height: auto;
    background: $panel;
    border-top: solid $primary;
    padding: 0 1;
}

PromptComposer Horizontal {
    width: 100%;
    height: auto;
    align: left bottom;
}

PromptTextArea {
    width: 1fr;
    height: 3;
    min-height: 3;
    max-height: 8;
    border: tall $primary-darken-1;
    background: $surface;
}

PromptTextArea:focus {
    border: tall $accent;
}

.send-btn {
    min-width: 8;
    height: 3;
    margin-left: 1;
    background: $primary;
    color: $text;
    text-style: bold;
}

.send-btn:hover, .send-btn:focus {
    background: $accent;
    color: $surface;
}

/* 4. Modal Screens (80x24 互換オーバーレイダイアログ) */
ApprovalModal,
AskUserModal,
IterationLimitModal,
TrustConsentModal,
ApiKeyModal,
ModelSelectModal,
SandboxStatusModal,
TokenUsageModal,
HelpModal {
    align: center middle;
    background: $background 60%;
}

.modal-dialog {
    width: 94%;
    max-width: 90;
    height: auto;
    max-height: 94%;
    background: $panel;
    border: round $accent;
    padding: 1 2;
}

.modal-dialog-warn {
    border: round $warning;
}

.modal-dialog-danger {
    border: round $error;
}

.modal-dialog-large {
    width: 96%;
    max-width: 112;
    height: auto;
    max-height: 94%;
    background: $panel;
    border: round $accent;
    padding: 1 2;
}

HelpModal > .modal-dialog-large {
    height: 90%;
    max-height: 34;
}

AskUserModal .modal-dialog,
ModelSelectModal > .modal-dialog-large,
SandboxStatusModal .modal-dialog-large {
    padding: 0 2;
}

.modal-title {
    width: 100%;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.modal-title-warn {
    color: $warning;
}

.modal-title-danger {
    color: $error;
}

.modal-scroll-body {
    width: 100%;
    height: auto;
    max-height: 28vh;
    background: $surface;
    border: solid $primary-darken-2;
    padding: 0 1;
    margin-bottom: 1;
}

AskUserModal .modal-scroll-body {
    max-height: 22vh;
    margin-bottom: 0;
}

SandboxStatusModal .modal-scroll-body {
    max-height: 20vh;
    margin-bottom: 0;
}

.modal-scroll-fill {
    width: 100%;
    height: 1fr;
    padding: 0 1;
}

#help-tabs {
    width: 100%;
    height: 1fr;
}

#help-tabs > ContentSwitcher {
    width: 100%;
    height: 1fr;
}

#help-tabs TabPane {
    width: 100%;
    height: 1fr;
    padding: 0;
}

.modal-hint {
    width: 100%;
    color: $text-muted;
    margin-top: 1;
}

.modal-error-msg {
    width: 100%;
    color: $error;
    text-style: bold;
}

.modal-option-list {
    width: 100%;
    height: auto;
    max-height: 22vh;
    margin-bottom: 1;
}

AskUserModal .modal-option-list {
    max-height: 20vh;
    margin-bottom: 0;
}

.model-select-option-list {
    width: 100%;
    height: 1fr;
    margin-bottom: 1;
}

.modal-data-table {
    width: 100%;
    height: auto;
    max-height: 36vh;
    margin: 1 0;
}

SandboxStatusModal .modal-data-table {
    max-height: 34vh;
    margin: 0;
}

.modal-buttons {
    width: 100%;
    height: auto;
    align: right middle;
    margin-top: 1;
}

.modal-buttons Button {
    margin-left: 1;
    min-width: 10;
}
